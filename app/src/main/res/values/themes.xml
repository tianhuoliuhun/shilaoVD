<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      全站深色。Material3 默认 colorPrimary 是薰衣草紫，会把 Button/控件染成
      与深蓝配色冲突的淡紫（真机实测：发送键、快捷回复都变紫）——这里统一换成我们的 accent。
    -->
    <style name="Theme.Dywatch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="colorPrimary">@color/accent</item>
        <!-- 🔴 必须用**不透明**色，否则 Android 6.0 开屏直接崩：
             系统会拿 android:colorPrimary 构造 TaskDescription 并校验 alpha==255，
             @color/accent 的 alpha=251 会抛「A TaskDescription's primary color should be opaque」。
             注意这是**系统属性**（android: 前缀），与上面 AppCompat 的 colorPrimary 不是同一个东西，
             上面那个保持原样，控件着色视觉零变化。 -->
        <item name="android:colorPrimary">@color/accent_solid</item>
        <item name="colorOnPrimary">@color/bg_base</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/bg_base</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- 品牌点缀色三处之一：statusBar（Bili pink 的唯一用途，同款逻辑） -->
        <item name="android:statusBarColor">@color/accent</item>
    </style>
</resources>
