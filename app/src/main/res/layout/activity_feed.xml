<?xml version="1.0" encoding="utf-8"?>
<!--
  myDVQ 唯一页面：全屏视频流。

  对照原基座：删掉了左上角"可见返回键"（本项目没有主屏可返回，系统返回即退出应用）
  和整条底部/顶部操作区。

  顶部两角是**信息栏**（用户要求）：左上角时间 + 日期，右上角星期 + 节日。
  设计上的三条约束：
    ① 垫半透明深色底 —— 视频画面什么颜色都有，纯白字压在亮画面上会看不见；
    ② 节日那一行没有节日时整行隐藏，不留空壳；
    ③ 状态提示（"正在加载…"）原来在顶部，会被信息栏压住，所以挪到**底部**。

  加载圈：首屏要等签名 + 拉流，内容区正中给个在转的指示器，比只有一行字更让人确信"它没死"。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.laorendouyin.app.widget.VerticalViewPager
        android:id="@+id/vvp"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================= 左上角：时间 + 日期 ================= -->
    <LinearLayout
        android:id="@+id/clock_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_info_panel"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/tv_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tv_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            tools:ignore="HardcodedText" />

        <!-- 农历：老人过日子看的是农历（九月初七），公历只是补充 -->
        <TextView
            android:id="@+id/tv_clock_lunar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- ================= 右上角：星期 + 节日 ================= -->
    <LinearLayout
        android:id="@+id/clock_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_info_panel"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <!-- 电量 + 预计可播放时长：放在星期上方；读不到电量时整行 GONE -->
        <TextView
            android:id="@+id/tv_clock_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:includeFontPadding="false"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tv_clock_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />

        <!-- 没有节日时整行 GONE（代码里控制），不留空壳 -->
        <TextView
            android:id="@+id/tv_clock_festival"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- 状态提示：放在**底部**（原来在顶部，会被上面的信息栏压住） -->
    <TextView
        android:id="@+id/tv_feed_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scrim"
        android:paddingLeft="@dimen/s4"
        android:paddingRight="@dimen/s4"
        android:paddingTop="@dimen/s2"
        android:paddingBottom="@dimen/s2"
        android:textColor="@color/accent"
        android:textSize="@dimen/t_caption"
        android:visibility="gone" />

    <include layout="@layout/include_loading" />

</FrameLayout>
